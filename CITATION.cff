        given-names: Arthur J.
      - family-names: Sanner
        given-names: Michel F.
    journal: "PLOS Computational Biology"
    volume: 11
    issue: 12
    year: 2015
    doi: "10.1371/journal.pcbi.1004586"
    notes: "ADFRsuite: grid maps and receptor preparation. Scripps."
