# Build output from pip installs and tests/test_packaging.py. A copy of the
# package, never something to commit.
build/
dist/
*.whl

# What an installation puts inside the checkout (INSTALL.md, install.sh): the
# conda environment, the ADCP 1.1 suite, their download caches and the
# activation script. Kept here rather than in the home directory.
env/
envs/
conda_shared/
# Everything an installation unpacks here is ignored; this repository's own
# script that lives beside it is not, or the documentation would ship with
# pictures and no way to take them again.
tools/*
!tools/docs_screenshots.py
.conda_pkgs/
.pip_cache/
activate.sh
